# Copy this file to .env and replace the placeholder with a random secret.
# Never commit .env to GitHub.
GUAC_DB_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_HEX
# 127.0.0.1 is safer: accessible only from the Windows host.
# For a temporary trusted LAN test use 0.0.0.0 and recreate the container.
GUAC_BIND_IP=127.0.0.1
GUAC_LOG_LEVEL=info
